<?xml version="1.0"?>
<ruleset
    name="BearSunday"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../vendor/squizlabs/php_codesniffer/phpcs.xsd"
>
    <description>BEAR.Sunday Coding Standard — extends Doctrine with BEAR.Sunday-specific sniffs.</description>

    <!-- Extend Doctrine Coding Standard -->
    <rule ref="Doctrine">
        <!--
            Allow inline parameter attributes. The Slevomat sniff defaults to
            forcing #[Attr] onto its own line, which makes #[Input] DTO
            signatures (function f(#[Input] Dto $input)) verbose. Class and
            property attributes are still written on their own line by convention.
        -->
        <exclude name="SlevomatCodingStandard.Attributes.AttributeAndTargetSpacing"/>
        <!-- BEAR.Sunday names interfaces *Interface, exceptions *Exception and abstract bases Abstract* -->
        <exclude name="SlevomatCodingStandard.Classes.SuperfluousInterfaceNaming"/>
        <exclude name="SlevomatCodingStandard.Classes.SuperfluousExceptionNaming"/>
        <exclude name="SlevomatCodingStandard.Classes.SuperfluousAbstractClassNaming"/>
        <!-- BEAR.Sunday code does not align assignments, and interpolates variables in strings -->
        <exclude name="Generic.Formatting.MultipleStatementAlignment.NotSame"/>
        <exclude name="Squiz.Strings.DoubleQuoteUsage.ContainsVar"/>
    </rule>

    <!-- ResourceObject declares $body, $code, $headers, $view and $uri without a type, so a resource cannot add one -->
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint.MissingNativeTypeHint">
        <exclude-pattern>*/Resource/*</exclude-pattern>
    </rule>

    <!-- BEAR.Sunday keeps the @psalm- and @phpstan- variants with their @param / @return -->
    <rule ref="SlevomatCodingStandard.Commenting.DocCommentSpacing">
        <properties>
            <property name="annotationsGroups" type="array">
                <element value="@param, @psalm-param, @phpstan-param"/>
                <element value="@return, @psalm-return, @phpstan-return"/>
                <element value="@Inject, @Named"/>
                <element value="@throws"/>
            </property>
        </properties>
    </rule>

    <!-- Forbidden debug/output functions -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="var_dump" value="null"/>
                <element key="print_r" value="null"/>
                <element key="dd" value="null"/>
                <element key="error_log" value="null"/>
                <element key="dump" value="null"/>
            </property>
        </properties>
    </rule>

    <!-- BEAR.Sunday custom sniffs check application code; tests keep the rules above -->
    <rule ref="BearSunday.Resources.ReturnStatic">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="BearSunday.Resources.NoSuperglobals">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="BearSunday.Resources.NoAbstractResource">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="BearSunday.Resources.NoFinalResource">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="BearSunday.Resources.StatusCodeConstant">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="BearSunday.Resources.HeaderConstant">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="BearSunday.DbQuery.RedundantType">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="BearSunday.Di.NoNewService">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="BearSunday.AppMeta.NoAppDirWritablePath">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>
